[Unit]
Description=Resy Bot
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/opt/resy-bot/backend
EnvironmentFile=/opt/resy-bot/.env
ExecStart=/opt/resy-bot/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
